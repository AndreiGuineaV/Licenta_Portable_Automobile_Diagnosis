<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLogTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPAIR"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="#2962FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>

            <TextView
                android:id="@+id/tvLogDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#888888"
                android:textSize="12sp"
                tools:text="20 May 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#1A2530"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Change of rear brake pads" />

        <TextView
            android:id="@+id/tvLogDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#555555"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="New Brembo brake pads mounted at the service AutoZone." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAEAEA"
            android:layout_marginVertical="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLogKm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1A2530"
                android:textStyle="bold"
                android:textSize="13sp"
                tools:text="🔧 145,200 km" />

            <TextView
                android:id="@+id/tvLogCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#388E3C"
                android:textStyle="bold"
                android:textSize="13sp"
                tools:text="💰 350 RON" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>