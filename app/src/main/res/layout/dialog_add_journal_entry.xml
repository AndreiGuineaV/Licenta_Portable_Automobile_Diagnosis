<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Journal Entry"
        android:textColor="#1A2530"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entry Type"
        android:textColor="#555555"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerLogType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Title (e.g. Oil Change)"
        android:textColor="#555555"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etLogTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:inputType="textCapWords"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description / Notes"
        android:textColor="#555555"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etLogDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:padding="8dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mileage (km)"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLogMileage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="number"
                android:background="@android:drawable/edit_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cost (RON) - Optional"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLogCost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="numberDecimal"
                android:background="@android:drawable/edit_text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#888888" />

        <Button
            android:id="@+id/btnSaveLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:backgroundTint="#2962FF"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>