<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Reminders"
        android:textColor="#1A2530"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ITP Expiration"
        android:textColor="#555555"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/dialogItpDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Tap to set"
        android:focusable="false"
        android:clickable="true"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RCA Expiration"
        android:textColor="#555555"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/dialogRcaDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Tap to set"
        android:focusable="false"
        android:clickable="true"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rovinieta Expiration"
        android:textColor="#555555"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/dialogRovinietaDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Tap to set"
        android:focusable="false"
        android:clickable="true"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next Oil Change"
        android:textColor="#555555"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/dialogOilDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Tap to set"
        android:focusable="false"
        android:clickable="true"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#888888" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:backgroundTint="#2962FF"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>